# Copy to .env and adjust. All settings use the ETA_ prefix.
ETA_DATABASE_URL=postgresql+asyncpg://eta:eta@localhost:5432/eta
ETA_REDIS_URL=redis://localhost:6379/0
ETA_CONFIG_DIR=./config
ETA_ADMIN_TOKEN=change-me
ETA_WORKER_CONCURRENCY=8
ETA_LEASE_SECONDS=60
ETA_HEARTBEAT_INTERVAL=15
ETA_LOG_JSON=true

# Webhook signing secrets (referenced by config/sources.yaml via secret_env)
GITHUB_WEBHOOK_SECRET=dev-github-secret
STRIPE_WEBHOOK_SECRET=whsec_dev
GENERIC_WEBHOOK_SECRET=dev-generic-secret

# Values exposed to workflow templates as {{ secrets.NAME }}
ETA_SECRET_NOTIFY_URL=http://localhost:9000/notify
ETA_SECRET_FULFILLMENT_URL=http://localhost:9000/fulfil
